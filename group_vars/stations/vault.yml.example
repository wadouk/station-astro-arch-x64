# Copier en vault.yml puis chiffrer :
#   cp group_vars/stations/vault.yml.example group_vars/stations/vault.yml
#   ansible-vault encrypt --vault-password-file .vault-pass group_vars/stations/vault.yml
# Mot de passe sudo de station_user (celui saisi dans make archinstall-config)
vault_become_password: "changeme"
# Mot de passe VNC : 6 à 8 caractères (VNC tronque au-delà de 8)
vault_vnc_password: "changeme"
# Réseaux Wi-Fi connus : ssid, psk (absent = réseau ouvert), priority (défaut 0),
# hidden (SSID masqué), key_mgmt (wpa-psk par défaut, sae pour du WPA3 seul)
vault_wifi_networks:
  - { ssid: "Maison", psk: "clé-wifi-maison", priority: 20 }
  - { ssid: "Club astro", psk: "clé-du-club", priority: 10 }
  - { ssid: "Telephone", psk: "clé-partage-4g", priority: 5 }
# Sauvegarde vers le NAS (rest-server restic en ajout seul, partage NFS pour les images), voir README
vault_backup_restic_repository: "rest:http://astro:mdp-rest-server@nas.local:8000/astro"
vault_restic_password: "mot-de-passe-de-chiffrement-restic"
vault_backup_nas_host: "nas.local"
vault_backup_images_nfs: "nas.local:/volume1/Astro"
# Clé WPA du point d'accès (8 caractères minimum), si hotspot_ssid est rempli
vault_hotspot_psk: "changeme-too"
