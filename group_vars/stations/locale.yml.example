# Fuseau horaire et clavier de TA station. Copier en locale.yml (non versionné) puis adapter :
#   cp group_vars/stations/locale.yml.example group_vars/stations/locale.yml
# Sans locale.yml : UTC et clavier QWERTY US.

# timedatectl list-timezones
station_timezone: Europe/Paris

# Disposition du clavier physique (indépendante de la langue du système).
# Console (localectl list-keymaps) et X11 (localectl list-x11-keymap-layouts) : us/us, uk/gb, fr/fr, de/de...
station_keymap: us
station_x11_layout: us
# Variante X11, ex. intl pour taper les accents sur un QWERTY US
station_x11_variant: ""
