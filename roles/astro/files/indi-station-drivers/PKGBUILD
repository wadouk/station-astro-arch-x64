# Pilotes INDI tiers de la station, compilés contre la libindi installée.
# Pourquoi pas les paquets AUR libindi-eqmod/-gphoto/-gpsd : ils exigent libindi=<version exacte> et
# décrochent à chaque mise à jour de libindi dans les dépôts officiels (2.2.4 exigé, 2.2.4.2 fourni).
# Recette reprise de ces paquets AUR ; un seul téléchargement pour les trois pilotes.
# Nouvelle version : changer pkgver et sha256sums (sha256sum de l'archive), remettre pkgrel=1.
pkgname=indi-station-drivers
pkgver=2.2.4.1
pkgrel=1
pkgdesc="Pilotes INDI tiers de la station : EQMod, GPhoto (Nikon/Canon), GPSD"
arch=(x86_64)
url="https://github.com/indilib/indi-3rdparty"
license=(GPL-3.0-or-later)
depends=('libindi>=2.2.4' libgphoto2 libraw gpsd)
makedepends=(cmake)
provides=(libindi-eqmod libindi-gphoto libindi-gpsd)
conflicts=(libindi-eqmod libindi-gphoto libindi-gpsd indi-3rdparty-drivers)
source=("indi-3rdparty-${pkgver}.tar.gz::https://github.com/indilib/indi-3rdparty/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('2ca31244224faa3db667baac71d6a7d2f056b0b8169ee1cdb37f7ca4a7203c25')

prepare() {
  cd "indi-3rdparty-${pkgver}"
  # Tous les pilotes désactivés par défaut, seuls ceux de la station sont activés au cmake
  sed -i -e '/option(WITH_.*On/s/ On)/ Off)/' CMakeLists.txt
  # Installer sous CMAKE_INSTALL_PREFIX et non dans /lib
  find ./ -name CMakeLists.txt -exec sed -i -e 's|"\/lib|"${CMAKE_INSTALL_PREFIX}/lib|g' {} \;
}

build() {
  cmake -B build -S "indi-3rdparty-${pkgver}" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DUDEVRULES_INSTALL_DIR=/usr/lib/udev/rules.d \
    -DWITH_EQMOD=On \
    -DWITH_GPHOTO=On \
    -DWITH_GPSD=On
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
