# {{ ansible_managed }}
[connection]
id=astro-hotspot
type=wifi
{% if wifi_iface %}
interface-name={{ wifi_iface }}
{% endif %}
autoconnect=true
autoconnect-priority=-10

[wifi]
mode=ap
band=bg
ssid={{ hotspot_ssid }}

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
psk={{ hotspot_psk }}

[ipv4]
method=shared

[ipv6]
method=ignore
